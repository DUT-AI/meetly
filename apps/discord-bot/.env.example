# Discord Bot Credentials
DISCORD_BOT_TOKEN="your_bot_token_here"
DISCORD_CLIENT_ID="your_client_id_here"
DISCORD_GUILD_ID="" # Optional: For instant guild-level slash command registration in development

# Meetly MinIO / S3 Storage Credentials
MINIO_ENDPOINT="https://dataplatforms3.dutai.io.vn"
MINIO_ROOT_USER="dutai"
MINIO_ROOT_PASSWORD="your_password"
DEFAULT_BUCKET="meetly-dev"
MINIO_SECURE="true"

# Bot Configuration
NODE_ENV="development" # Set to "production" in live environments
ENABLE_PREVIEW_URL="true" # Set to "false" in production to avoid exposing raw audio links in Discord chat
MAX_MEETING_DURATION_MINUTES="180"
SILENCE_TIMEOUT_MINUTES="5"
TEMP_DIR="./tmp"
LOG_LEVEL="info"
