# Environment Configuration for Meetly (.env.example)
DATABASE_URL=postgresql+asyncpg://meetly:meetly_password@localhost:5432/meetly_db

# Redis Cache & Broker Configuration
REDIS_URL=redis://localhost:6379/0

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-very-secure-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cookie Authentication Configuration
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE=86400

# External Auth & Manage Server (dut-ai-data-platform style)
AUTH_SERVER_URL=https://auth.example.com/api/v1
MANAGE_SERVER_URL=https://manage.example.com/api/v1
EXTERNAL_API_TIMEOUT=10.0

# MinIO / S3 Storage Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=meetly_minio
MINIO_ROOT_PASSWORD=meetly_minio_secret
MINIO_ACCESS_KEY=meetly_minio
MINIO_SECRET_KEY=meetly_minio_secret
DEFAULT_BUCKET=meetly-uploads
MINIO_SECURE=false

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
